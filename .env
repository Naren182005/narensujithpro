# Digital Legacy Platform - Development Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Security
JWT_SECRET=digital-legacy-super-secure-jwt-secret-key-2024
ENCRYPTION_KEY=digital-legacy-32-char-key-2024!
SESSION_SECRET=digital-legacy-session-secret-2024

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digital_legacy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# MongoDB
MONGODB_URI=mongodb://localhost:27017/digital_legacy

# Redis
REDIS_URL=redis://localhost:6379

# Email (optional for development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# OpenAI (optional for development)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png

# Security Settings
BCRYPT_ROUNDS=12
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
DEBUG=true
ENABLE_CORS=true
TRUST_PROXY=false
